# OpenColab Core Configuration
# Copy this file to .env (or .env.dev for local development)
# Priority: database (Admin UI) > environment variables > .env.{environment} > .env
#
# Application settings use OPENCOLAB_ names except explicit aliases such as POSTGRES_*.

# ==============================================================================
# Bootstrap Settings (CANNOT be changed via UI, must be set here or in env)
# ==============================================================================

# Environment name — determines which .env.{env} file is loaded (default: dev)
# OPENCOLAB_ENV=dev

# Debug mode (default: False)
# OPENCOLAB_DEBUG=False

# Secret key for JWT signing (CHANGE THIS in production)
OPENCOLAB_SECRET_KEY=change-me-in-production

# JWT access token expiration in minutes (default: 1440 = 24 hours)
# OPENCOLAB_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial admin password (REQUIRED on first run, used to seed the admin account)
# The app will refuse to start if this is empty and no admin user exists yet.
OPENCOLAB_ADMIN_PASSWORD=

# PostgreSQL (required). Copy to .env and set your credentials.
# Docker Compose uses POSTGRES_* for the postgres service container config.
# NOTE: When running backend/worker locally (outside Docker), use the HOST-MAPPED
# port (8432), not the container-internal port (5432).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=opencolab
POSTGRES_HOST=localhost
POSTGRES_PORT=8432   # host-mapped port; use 5432 only inside Docker containers

# Alternative: full URL (overrides POSTGRES_* if set)
# OPENCOLAB_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Qdrant vector store connection
# NOTE: When running backend/worker locally (outside Docker), use the HOST-MAPPED
# port (8433), not the container-internal port (6333).
OPENCOLAB_QDRANT_HOST=localhost
OPENCOLAB_QDRANT_PORT=8433   # host-mapped port; use 6333 only inside Docker containers
OPENCOLAB_QDRANT_COLLECTION=opencolab_chunks

# Host ports for the Docker Compose stack. PostgreSQL 8432 and Qdrant 8433 are
# mapped above; inside the containers everything keeps its default port.
FRONTEND_PORT=8430
API_PORT=8431

# Which compose files to resolve, and the only switch between the two frontend
# modes. Leave this unset (the dev default) for a working machine: the base file
# runs Vite with ./frontend bind-mounted, so edits hot-reload and the api runs
# uvicorn --reload. Set it on a host that should serve the built site instead:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml
# which builds frontend/Dockerfile's production stage, serves dist from nginx on
# 80, and drops the api reloader. Compose reads this line from the env file
# itself, so no shell state and no per-command -f flag is needed; ./scripts/
# docker-start.sh then prints which of the two it is about to start.
# Note the two modes use different image names for the frontend, so switching
# back and forth recreates the container instead of reusing the wrong image.
# COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml

# ==============================================================================
# Runtime Settings (can also be changed via Admin UI, stored in database)
# ==============================================================================

# LLM Configuration
# Supported formats: gpt-4o-mini, ollama/llama3, anthropic/claude-3-haiku, etc.
OPENCOLAB_LLM_MODEL=gpt-4o-mini
# Default generation budget for chat/workflow answers. Increase for long research synthesis.
OPENCOLAB_LLM_RESPONSE_MAX_TOKENS=1600
# API base URL (required for Ollama or custom endpoints)
# OPENCOLAB_LLM_API_BASE=http://localhost:11434
# Optional HTTP/HTTPS proxy for outbound LLM requests (empty by default)
# Example: http://127.0.0.1:7890
# OPENCOLAB_LLM_PROXY=
# Optional build-time proxy for Docker image builds (apt + pip).
# Use a host-reachable HTTP proxy when running `docker compose build`.
# Example for Docker Desktop: http://host.docker.internal:7890
# APT_HTTP_PROXY=http://host.docker.internal:7890
# APT_HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=http://host.docker.internal:7890
# Optional pip timeout in seconds for slow or proxied networks.
# PIP_DEFAULT_TIMEOUT=120
# API key — if set, overrides provider-specific env vars (OPENAI_API_KEY, etc.)
# When empty, LiteLLM auto-detects OPENAI_API_KEY / ANTHROPIC_API_KEY from env.
# OPENCOLAB_LLM_API_KEY=

# Embedding model (local Hugging Face model name)
OPENCOLAB_EMBEDDING_MODEL=BAAI/bge-m3
# Embedding provider: local | siliconflow
OPENCOLAB_EMBEDDING_PROVIDER=local
# Fallback provider when primary provider fails: none | local | siliconflow
OPENCOLAB_EMBEDDING_FALLBACK_PROVIDER=none
# Optional local model path in container (for offline deployments)
# OPENCOLAB_EMBEDDING_LOCAL_MODEL_PATH=/models/bge-m3
# Force local-files-only loading for sentence-transformers in offline environments
OPENCOLAB_EMBEDDING_LOCAL_FILES_ONLY=true
# SiliconFlow embedding config (used when provider is siliconflow, or as fallback)
# OPENCOLAB_SILICONFLOW_API_KEY=
OPENCOLAB_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
OPENCOLAB_SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Persistent model caches mounted by docker-compose worker at ./models
HF_HOME=/models/huggingface
HUGGINGFACE_HUB_CACHE=/models/huggingface/hub
TRANSFORMERS_CACHE=/models/huggingface/transformers
TORCH_HOME=/models/torch
XDG_CACHE_HOME=/models/cache

# Document processing worker URL (for query-time embedding)
OPENCOLAB_WORKER_URL=http://localhost:8001

# File storage
OPENCOLAB_UPLOAD_DIR=./uploads
OPENCOLAB_SKILL_PACK_DIR=./skill-packs
# Bearer token the api uses to call the codex-sandbox service. Docker Compose
# reads this one variable for both sides, so they cannot drift apart; it has no
# default, and compose refuses to resolve the file without a value.
# Generate one: openssl rand -hex 32
OPENCOLAB_CODEX_RUNTIME_API_KEY=
# Codex sandbox shared workspace (host dir and the path inside the sandbox container).
# Required for skill pack runs and workflow-runs context export.
OPENCOLAB_CODEX_RUNTIME_WORKSPACE_DIR=./codex-workspace
OPENCOLAB_CODEX_RUNTIME_SANDBOX_WORKSPACE_DIR=/workspace
# Wire protocol the codex sandbox uses with OPENCOLAB_LLM_API_BASE.
# Keep "responses" for OpenAI-compatible endpoints that support the Responses API;
# set to "chat" for gateways that cannot sustain Responses-API streaming (e.g. some LiteLLM proxies).
OPENCOLAB_CODEX_WIRE_API=responses
OPENCOLAB_MAX_FILE_SIZE_MB=50
# Prefer the lab-owned PP-StructureV3 service when a token is configured. The
# legacy PPS_LOCAL_API_KEY and LOCAL_MODEL_SERVICE_TOKEN names are also accepted.
OPENCOLAB_PDF_PPS_ENABLED=false
OPENCOLAB_PDF_PPS_JOBS_URL=
# OPENCOLAB_PDF_PPS_API_KEY=
OPENCOLAB_PDF_PPS_TIMEOUT_SECONDS=300
OPENCOLAB_PDF_PPS_POLL_INTERVAL_SECONDS=3
# Maximum local marker parsing time before falling back to basic text extraction
OPENCOLAB_PDF_PARSE_TIMEOUT_SECONDS=180
# Marker is memory/compute heavy on CPU. Keep disabled unless the worker image and
# deployment have enough memory or CUDA-enabled PyTorch.
OPENCOLAB_PDF_MARKER_ENABLED=false
OPENCOLAB_PDF_MARKER_PRELOAD_ENABLED=false
OPENCOLAB_WORKER_MAX_CONCURRENT=1
# OPENCOLAB_PDF_MARKER_DEVICE=cuda
# OPENCOLAB_PDF_MARKER_DTYPE=float16

# Optional exact-identifier bibliographic lookup. When enabled, only DOI,
# PMID, PMCID, or arXiv IDs are sent to the corresponding official provider.
# PDF files, parsed text, title candidates, and author candidates stay local.
OPENCOLAB_BIBLIOGRAPHIC_LOOKUP_ENABLED=false
OPENCOLAB_BIBLIOGRAPHIC_AUTO_APPLY_ENABLED=false
# Required when online bibliographic lookup is enabled.
# OPENCOLAB_BIBLIOGRAPHIC_LOOKUP_CONTACT_EMAIL=admin@example.org

# RAG parameters
OPENCOLAB_CHUNK_SIZE=512
OPENCOLAB_CHUNK_OVERLAP=64
OPENCOLAB_RAG_TOP_K=5
