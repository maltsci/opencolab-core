{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab Knowledge OS v1 benchmark",
  "type": "object",
  "required": ["frozen_at", "questions"],
  "properties": {
    "frozen_at": {"type": "string", "format": "date"},
    "questions": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "question",
          "expected_behavior",
          "permission_profiles",
          "rubric"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^LK-[0-9]{3}$"},
          "category": {
            "enum": ["people", "research", "resources", "cross_entity"]
          },
          "question": {"type": "string", "minLength": 5},
          "expected_behavior": {
            "enum": ["answer", "no_answer", "permission_limited"]
          },
          "permission_profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "admin",
                "pi",
                "member_with_project_access",
                "member_without_project_access"
              ]
            }
          },
          "rubric": {
            "type": "object",
            "required": [
              "required_entity_types",
              "required_source_titles",
              "notes"
            ],
            "properties": {
              "required_entity_types": {
                "type": "array",
                "items": {
                  "enum": ["person", "research_direction", "resource"]
                }
              },
              "required_source_titles": {
                "type": "array",
                "items": {"type": "string"}
              },
              "notes": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
